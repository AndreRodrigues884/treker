# vitest 5 / vite 8 / @vitejs/plugin-react 6 têm peer dependencies que se
# sobrepõem parcialmente (ex.: ranges de @types/node) sem serem realmente
# incompatíveis na prática — confirmado com build/typecheck/lint/testes a
# passar. Sem isto, `npm install` falha com ERESOLVE (viu-se isto na Vercel).
legacy-peer-deps=true
